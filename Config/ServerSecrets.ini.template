; ==========================================================================
; Faldoran Prime MMO — Server Secrets Configuration
; ==========================================================================
; INSTRUCTIONS:
;   1. Copy this file to: Config/ServerSecrets.ini
;   2. Fill in your actual database credentials below
;   3. NEVER commit ServerSecrets.ini to version control
;
; Alternatively, set environment variables (highest priority):
;   FPM_DB_HOST, FPM_DB_PORT, FPM_DB_NAME, FPM_DB_USER, FPM_DB_PASSWORD
;   FPM_SERVER_IP, FPM_SERVER_PORT
;
; Priority order:
;   1. Environment variables (if set)
;   2. Config/ServerSecrets.ini (if present)
;   3. Built-in defaults (localhost:5432, no password)
; ==========================================================================

[FPM.Database]
Host=localhost
Port=5432
DatabaseName=faldoran_prime
Username=fpm_server
Password=CHANGE_ME

[FPM.Server]
; Dedicated server IP address and port for client auto-connect.
ServerIP=127.0.0.1
ServerPort=7777
bAutoConnect=false

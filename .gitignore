# Unreal Engine 5 .gitignore

# Compiled binaries and intermediates
Binaries/
Intermediate/
DerivedDataCache/

# Saved state (local only)
Saved/

# Content assets (tracked via Perforce / LFS, not raw Git)
*.uasset
*.umap

# --- Raw file assets (source art, models, audio) ---
RawAssets/
RawTextures/

# Raw image formats
*.psd
*.tga
*.bmp
*.tif
*.tiff
*.exr
*.hdr
*.r16
*.r32

# Raw 3D model formats
*.fbx
*.obj
*.blend
*.blend1
*.ma
*.mb
*.max
*.3ds
*.dae

# Raw audio formats
*.wav
*.flac
*.aiff
*.aif

# IDE files
.vs/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Visual Studio user files
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# macOS
.DS_Store

# Thumbnails
__pycache__/
*.pyc

# Build artifacts
Build/

# Packaged builds
PackagedServer/
PackagedClient/

# PostgreSQL installer (temp)
postgresql-*.exe

# --- Server Secrets (NEVER commit) ---
Config/ServerSecrets.ini
Config/ServerSecrets*.ini
!Config/ServerSecrets.ini.template
*.env
.env.*
ServerConfig/

# --- Credential and key files ---
*.pem
*.key
*.p12
*.pfx
